# Neon Postgres (Vercel provisions these automatically when the Neon integration is connected)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 48+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Bearer secret for the daily Vercel Cron (/api/cron/reminders)
CRON_SECRET=

# Optional overrides
# MEZO_RPC_URL=https://rpc.test.mezo.org
# NEXT_PUBLIC_SITE_URL=https://musd-escrowflow.vercel.app

# Scripts only (never commit real values; keys are read from files OUTSIDE the repo):
# DEPLOYER_ENV_FILE=C:\path\outside\repo\.env.txt      (line PRIVATE_KEY=...)
# TEST_WALLETS_FILE=C:\path\outside\repo\test-wallets.json
# BASE_URL=http://localhost:3000                      (e2e target)
# E2E_DIVISOR=10                                      (scale project A for rehearsals)
